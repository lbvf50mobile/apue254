<table>
  <caption><%= info %></caption>
  <thead>
    <tr>
      <th>Name of limit</th>
      <th>Description</th>
      <th>name argument</th>
    </tr>
  </thead>
  <tbody>
    <% data.each do |row| %>
      <tr>
        <td>
          <label>
            <input type="checkbox" class="toggle" hidden><%= row[:limit] %>
          </label>
        </td>
        <td>
          <%= row[:descr] %>
          <div class="long_descr">
            <%= row[:long_descr] %>
          </div>
        </td>
        <td><%= row[:name_arg] %></td>
      </tr>
    <% end %>
  </tbody>
</table>

