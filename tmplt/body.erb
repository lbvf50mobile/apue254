<table>
  <caption><%= info %></caption>
  <thead>
    <tr>
      <th>Name of limit</th>
      <th>Description</th>
      <th>name argument</th>
    </tr>
  </thead>
  <tbody>
    <% data.each do |row| %>
      <tr>
        <td><%= row[:limit] %></td>
        <td><%= row[:descr] %></td>
        <td><%= row[:name_arg] %></td>
      </tr>
    <% end %>
  </tbody>
</table>
